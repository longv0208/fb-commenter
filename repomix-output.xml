import pytest

import main


class FakeResponse:
    def __init__(self, *, is_success=True, payload=None):
        self.is_success = is_success
        self._payload = payload if payload is not None else {}

    def json(self):
        return self._payload


class FakeAsyncClient:
    response = FakeResponse()
    calls = []

    def __init__(self, **kwargs):
        self.kwargs = kwargs

    async def __aenter__(self):
        type(self).calls.append(("client", self.kwargs))
        return self

    async def __aexit__(self, exc_type, exc, traceback):
        return False

    async def get(self, url, params, headers=None):
        type(self).calls.append(("get", url, params))
        type(self).calls.append(("headers", headers))
        return type(self).response


@pytest.mark.asyncio
async def test_resolve_page_id_success_and_request_shape(monkeypatch):
    FakeAsyncClient.calls = []
    FakeAsyncClient.response = FakeResponse(payload={"id": " 123456789 "})
    monkeypatch.setattr(main.httpx, "AsyncClient", FakeAsyncClient)

    page_id = await main.resolve_page_id("page-token", "http://proxy:8080")

    assert page_id == "123456789"
    assert FakeAsyncClient.calls[0] == (
        "client",
        {"timeout": 30.0, "follow_redirects": True, "proxy": "http://proxy:8080"},
    )
    assert FakeAsyncClient.calls[1] == (
        "get",
        "https://graph.facebook.com/v26.0/me",
        {"fields": "id"},
    )
    assert FakeAsyncClient.calls[2] == (
        "headers",
        {"Authorization": "Bearer page-token"},
    )


@pytest.mark.asyncio
async def test_resolve_page_id_rejects_http_error_without_secret(monkeypatch):
    FakeAsyncClient.response = FakeResponse(
        is_success=False,
        payload={"error": {"message": "invalid access_token=secret-token"}},
    )
    monkeypatch.setattr(main.httpx, "AsyncClient", FakeAsyncClient)

    with pytest.raises(RuntimeError) as error:
        await main.resolve_page_id("secret-token")

    message = str(error.value)
    assert "secret-token" not in message
    assert "Page Access Token" in message


@pytest.mark.asyncio
async def test_resolve_page_id_rejects_missing_id(monkeypatch):
    FakeAsyncClient.response = FakeResponse(payload={"name": "Page"})
    monkeypatch.setattr(main.httpx, "AsyncClient", FakeAsyncClient)

    with pytest.raises(RuntimeError, match="không trả về Facebook Page ID"):
        await main.resolve_page_id("page-token")


class MalformedResponse(FakeResponse):
    def json(self):
        raise ValueError("response body is not JSON")


@pytest.mark.asyncio
async def test_resolve_page_id_rejects_malformed_json(monkeypatch):
    FakeAsyncClient.response = MalformedResponse()
    monkeypatch.setattr(main.httpx, "AsyncClient", FakeAsyncClient)

    with pytest.raises(RuntimeError, match="không trả về Facebook Page ID"):
        await main.resolve_page_id("secret-token")


@pytest.mark.asyncio
@pytest.mark.parametrize("page_id", [True, {"nested": 1}, "not-numeric", "  "])
async def test_resolve_page_id_rejects_non_numeric_ids(monkeypatch, page_id):
    FakeAsyncClient.response = FakeResponse(payload={"id": page_id})
    monkeypatch.setattr(main.httpx, "AsyncClient", FakeAsyncClient)

    with pytest.raises(RuntimeError, match="không trả về Facebook Page ID"):
        await main.resolve_page_id("page-token")


@pytest.mark.asyncio
async def test_resolve_page_id_hides_transport_error(monkeypatch):
    class FailingClient(FakeAsyncClient):
        async def get(self, url, params, headers=None):
            raise main.httpx.ConnectTimeout(
                "https://graph.facebook.com/v26.0/me?access_token=secret-token"
            )

    monkeypatch.setattr(main.httpx, "AsyncClient", FailingClient)

    with pytest.raises(RuntimeError) as error:
        await main.resolve_page_id("secret-token")

    assert "secret-token" not in str(error.value)
    assert "Không thể kết nối" in str(error.value)
